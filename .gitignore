.DS_Store
__pycache__/
*.pyc

# viewer: generated locally, contains private investigation content — never commit
viewer/index.json
viewer/.run/

# dashboard runtime data (collected locally, private) now lives OUTSIDE the repo,
# under $FX_DASHBOARD_DIR (default ~/.fx-bug-toolkit/dashboard) — nothing to ignore
# in the package. These stale-path guards remain only in case a dev points
# FX_DASHBOARD_DIR back at the package dir.
dashboard/*.json
dashboard/.run/

# test deps (one node package at the repo root serves tests/ and viewer/tests/)
/node_modules/
/package-lock.json

# personal, per-machine Claude Code permission overrides — never commit
.claude/settings.local.json
